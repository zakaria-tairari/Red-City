# Source API endpoints
API_CATEGORIES_URL=https://example.com/categories
API_PLACES_URL=https://example.com/places

# Source API request headers
API_USER_AGENT="RedCityDataEngine/1.0"
API_ACCEPT=application/json
API_ACCEPT_LANGUAGE=fr
API_AUTHORIZATION=

# Database used by the Laravel backend
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_DATABASE=red_city

# AI tag generation
OPENROUTER_API_KEY=

# Translation service
OPENTRANSLATE_URL=http://127.0.0.1:5000/translate
